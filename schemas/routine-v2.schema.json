{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repzena.github.io/schemas/routine-v2.schema.json",
  "title": "Repzena routine export v2 and v3",
  "type": "object",
  "required": ["format", "version", "routine"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "gym-exercise-routine"
    },
    "version": {
      "enum": [2, 3]
    },
    "routine": {
      "$ref": "#/definitions/routine"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": { "const": 3 }
        }
      },
      "then": {
        "properties": {
          "routine": {
            "type": "object",
            "properties": {
              "days": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "exercises": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": ["prescription"]
                            }
                          }
                        }
                      }
                    },
                    "unsectioned_exercises": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["prescription"]
                      }
                    },
                    "exercises": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["prescription"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/localized"
        }
      ]
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "minProperties": 1
    },
    "exercise": {
      "type": "object",
      "required": ["name", "sets", "reps_or_time", "section"],
      "properties": {
        "name": {
          "$ref": "#/definitions/text"
        },
        "exercise_id": {
          "type": ["string", "null"]
        },
        "sets": {
          "type": "number",
          "minimum": 1,
          "maximum": 99
        },
        "reps_or_time": {
          "$ref": "#/definitions/text"
        },
        "prescription": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["reps", "time"] },
            "reps": { "$ref": "#/definitions/text" },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "time" } } },
              "then": { "required": ["duration_seconds"] }
            },
            {
              "if": { "properties": { "mode": { "const": "reps" } } },
              "then": { "required": ["reps"] }
            }
          ]
        },
        "section": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": ["type", "name"],
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "routine": {
      "type": "object",
      "required": ["name", "default_name", "days"],
      "properties": {
        "name": {
          "$ref": "#/definitions/text"
        },
        "default_name": {
          "type": "boolean"
        },
        "days": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["name", "default_name", "sections", "unsectioned_exercises", "exercises"],
            "properties": {
              "name": {
                "$ref": "#/definitions/text"
              },
              "default_name": {
                "type": "boolean"
              },
              "sections": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": ["type", "name", "exercises"],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "name": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "#/definitions/text"
                        }
                      ]
                    },
                    "exercises": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/exercise"
                      }
                    }
                  }
                }
              },
              "unsectioned_exercises": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/exercise"
                }
              },
              "exercises": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/exercise"
                }
              }
            }
          }
        }
      }
    }
  }
}
