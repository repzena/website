{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repzena.github.io/schemas/routine-v2.schema.json",
  "title": "Repzena routine export v2",
  "type": "object",
  "required": ["format", "version", "routine"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "gym-exercise-routine"
    },
    "version": {
      "const": 2
    },
    "routine": {
      "$ref": "#/definitions/routine"
    }
  },
  "definitions": {
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/localized"
        }
      ]
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "minProperties": 1
    },
    "exercise": {
      "type": "object",
      "required": ["name", "sets", "reps_or_time", "section"],
      "properties": {
        "name": {
          "$ref": "#/definitions/text"
        },
        "exercise_id": {
          "type": ["string", "null"]
        },
        "sets": {
          "type": "number",
          "minimum": 1,
          "maximum": 99
        },
        "reps_or_time": {
          "$ref": "#/definitions/text"
        },
        "section": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": ["type", "name"],
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "routine": {
      "type": "object",
      "required": ["name", "default_name", "days"],
      "properties": {
        "name": {
          "$ref": "#/definitions/text"
        },
        "default_name": {
          "type": "boolean"
        },
        "days": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["name", "default_name", "sections", "unsectioned_exercises", "exercises"],
            "properties": {
              "name": {
                "$ref": "#/definitions/text"
              },
              "default_name": {
                "type": "boolean"
              },
              "sections": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": ["type", "name", "exercises"],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "name": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "#/definitions/text"
                        }
                      ]
                    },
                    "exercises": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/exercise"
                      }
                    }
                  }
                }
              },
              "unsectioned_exercises": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/exercise"
                }
              },
              "exercises": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/exercise"
                }
              }
            }
          }
        }
      }
    }
  }
}
